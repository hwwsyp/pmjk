<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tpfh.fintech.modules.pmjk.cashflowdivide.dao.CashflowDivideLineDao">
    <select id="listByBatchId" resultType="com.tpfh.fintech.modules.pmjk.cashflowdivide.entity.CashflowDivideLineEntity">
        select * from pmjk_cashflow_divide_line where batch_id = #{batchId} order by line_no
    </select>
    <delete id="deleteByBatchId">
        delete from pmjk_cashflow_divide_line where batch_id = #{batchId}
    </delete>
</mapper>
