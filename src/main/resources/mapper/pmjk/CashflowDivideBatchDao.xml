<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tpfh.fintech.modules.pmjk.cashflowdivide.dao.CashflowDivideBatchDao">
    <select id="getBatchListForPage" resultType="com.tpfh.fintech.modules.pmjk.cashflowdivide.entity.CashflowDivideBatchEntity">
        select * from pmjk_cashflow_divide_batch
        <where>
            <if test="productShortName != null and productShortName != ''">
                and product_short_name like '%' || #{productShortName} || '%'
            </if>
        </where>
        order by createtimestamp desc
    </select>
</mapper>
