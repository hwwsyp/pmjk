<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tpfh.fintech.modules.pmjk.portfoliostock.dao.PortfolioStockDao">

    <sql id="allColumns">
        id,
        port_code,
        stock_date,
        sec_code,
        dc_code,
        amount,
        km_code,
        km_name,
        createtimestamp,
        updatetimestamp,
        islock
    </sql>

    <sql id="listWhere">
        <where>
            <if test="portCode != null and portCode != ''"> and port_code like '%' || #{portCode} || '%'</if>
            <if test="stockDate != null and stockDate != ''"> and stock_date = to_date(#{stockDate}, 'yyyy-mm-dd')</if>
            <if test="secCode != null and secCode != ''"> and sec_code like '%' || #{secCode} || '%'</if>
            <if test="dcCode != null and dcCode != ''"> and dc_code = #{dcCode}</if>
            <if test="kmCode != null and kmCode != ''"> and km_code like #{kmCode} || '%'</if>
            <if test="kmName != null and kmName != ''"> and km_name like '%' || #{kmName} || '%'</if>
        </where>
    </sql>

    <select id="getPortfolioStockListForPage" resultType="com.tpfh.fintech.modules.pmjk.portfoliostock.entity.PortfolioStockEntity">
        select <include refid="allColumns"/> from pmjk_portfolio_stock
        <include refid="listWhere"/>
        order by port_code, sec_code
    </select>

    <select id="getPortfolioStockList" resultType="com.tpfh.fintech.modules.pmjk.portfoliostock.entity.PortfolioStockEntity">
        select <include refid="allColumns"/> from pmjk_portfolio_stock
        <include refid="listWhere"/>
        order by port_code, sec_code
    </select>

    <delete id="deleteByStockDate">
        delete from pmjk_portfolio_stock
        where stock_date = to_date(#{stockDate}, 'yyyy-mm-dd')
    </delete>
</mapper>
